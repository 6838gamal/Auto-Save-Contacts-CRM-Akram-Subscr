# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# SUBSCRIPTION_API_BASE_URL: Base URL of your PostgreSQL backend API (e.g. https://api.yourdomain.com/)
SUBSCRIPTION_API_BASE_URL=https://api.example.com/

# SUBSCRIPTION_API_KEY: API key / Bearer token for your PostgreSQL backend API
SUBSCRIPTION_API_KEY=MY_SUBSCRIPTION_API_KEY
